<?xml version="1.0" encoding="utf-8"?>
<!--
  FASMH-94 PoC 설정 파일.

  빌드하면 bin\x64\<Config>\EtoosDetectSample.exe.config 로 복사된다.
  현장에서는 그 파일만 메모장으로 고치고 앱을 재시작하면 된다. 재빌드 불필요.

  값 파싱은 전부 InvariantCulture 다. 소수점은 반드시 마침표(.) 를 쓸 것. 쉼표는 파싱 실패한다.
  파싱에 실패하거나 키가 없으면 조용히 코드 기본값(Config\AppSettings.cs)을 쓰고,
  경고 목록에만 남긴다. 앱은 죽지 않는다.

  [잠정치] 표시가 붙은 항목은 근거가 약한 값이다. 현장 재보정 전제.
-->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <appSettings>

    <!-- ============================================================
         좌석
         ============================================================ -->
    <!-- 이 PC 가 감시하는 좌석 ID. CSV/JSONL 로그와 알림에 그대로 찍힌다. -->
    <add key="SeatId" value="S-01" />

    <!-- ============================================================
         눈 개폐 판정
         ============================================================ -->
    <!-- DetectClosedEyes 가 주는 eyelid distance 가 이 값 이하이면 Closed 로 본다.
         [잠정치] 근거: SDK 샘플 DemoClientServer.cs:390-394 의 2.4.
         이 값은 '얼굴이 화면에서 차지하는 크기'에 직접 비례한다.
         카메라가 멀면 눈꺼풀 거리가 통째로 작아져서 항상 Closed 로 보인다.
         => 설치 거리를 바꾸면 반드시 재보정할 것. 눈 뜬 상태의 실측값을 UI 에서 보고 정한다. -->
    <add key="EyelidClosedThreshold" value="2.4" />

    <!-- ============================================================
         게이트 (이 조건을 못 넘으면 EyeState=Unknown 으로 떨어진다)
         ============================================================ -->
    <!-- ComputeLandmarkConfidence 하한. 0.0~1.0. 낮추면 흐릿한 프레임도 판정에 쓴다.
         [잠정치, 2026-08-24 완화] 원래 근거는 SDK 샘플의 0.90(근접 셀피 기준) — 책상 거리 카메라를 쓰는
         이 PoC에서는 "판정불가"가 너무 잦아 0.75 로 낮췄다. 추가 조정은 앱의 "판정 설정" 창을 쓸 것. -->
    <add key="LandmarkConfMin" value="0.75" />

    <!-- DetectFaceOcclusion 의 눈 가림 점수 상한. 이 값을 넘으면 EyeOccluded 로 Unknown.
         방향 확정(부록 A-3): 가려질수록 값이 '높아진다'. 즉 occl > OcclusionMax 이면 가려짐.
         [잠정치, 2026-08-24 완화] 0.50 → 0.60. 현장 재보정 대상, "판정 설정" 창 사용 권장. -->
    <add key="OcclusionMax" value="0.60" />

    <!-- DetectFineOcclusion 점수 상한. UseFineOcclusionGate=true 일 때만 쓴다.
         방향 확정(부록 A-4): OcclusionMax 와 동일하게 가려질수록 값이 높아진다.
         [잠정치, 2026-08-24 완화] 0.50 → 0.60(OcclusionMax 와 동일 방향). 재보정 대상. -->
    <add key="FineOcclusionMax" value="0.60" />

    <!-- FineOcclusion 을 게이트에 반영할지. 방향이 확정되어 기본 true 다.
         해당 모델이 배포 model 패키지에 없을 수 있으므로, FaceEngine 이 첫 호출 실패 시
         런타임에 자동 비활성한다(안전장치). 그 경우 이 값이 true 여도 무시되고 사유가 로그에 남는다.
         2026-08-24 재검토: EyeStateGate 판정 로직에서 실사용 중임을 재확인, 제거하지 않고 유지하기로 함. -->
    <add key="UseFineOcclusionGate" value="true" />

    <!-- 고개 좌우(yaw) / 상하(pitch) 허용 각도. 넘으면 PoseOutOfRange 로 Unknown.
         [잠정치] 옆모습에서 눈꺼풀 거리가 급격히 왜곡되는 것을 막는 용도.
         엎드림 감지를 원하면 PosePitchMaxDeg 를 너무 좁히지 말 것.
         2026-08-24: PoseYawMaxDeg 는 "판정불가"의 주 원인으로 추정되어 35.0 → 45.0 으로 완화.
         PosePitchMaxDeg 는 엎드림 휴리스틱과 상충할 수 있어 유지 — 추가 조정은 "판정 설정" 창으로. -->
    <add key="PoseYawMaxDeg" value="45.0" />
    <add key="PosePitchMaxDeg" value="25.0" />

    <!-- ============================================================
         시간 임계 (초)
         ============================================================ -->
    <!-- 눈 감김 의심 / 확정. Confirm 5.0 은 FASMH-94 문서 명시값(재보정 대상 아님). -->
    <add key="ClosedEyeSuspectSec" value="2.0" />
    <add key="ClosedEyeConfirmSec" value="5.0" />

    <!-- 얼굴 미검출 의심 / 확정(이석). Confirm 5.0 은 FASMH-94 문서 명시값. -->
    <add key="NoFaceSuspectSec" value="2.0" />
    <add key="NoFaceConfirmSec" value="5.0" />

    <!-- Unknown 이 이 시간 미만이면 직전 상태를 유지한다(깜빡임/순간 흔들림 흡수).
         [잠정치, 2026-08-24 완화] 1.5 → 3.0. "5초 통일" 상한 이내로 유지하면서 짧은 시선 이탈이
         즉시 "판정불가"로 뜨지 않도록 넓혔다. -->
    <add key="UnknownGraceSec" value="3.0" />

    <!-- 같은 종류의 알림을 다시 내보내기까지의 최소 간격. [잠정치] -->
    <add key="AlertCooldownSec" value="15.0" />

    <!-- ============================================================
         PERCLOS (눈 감고 있던 시간 비율)
         ============================================================ -->
    <!-- 관측 윈도우 길이(초) 와 졸음 의심 비율. [잠정치]
         일반적으로 PERCLOS 는 60~180초 윈도우에 0.15~0.4 를 쓴다. 데모 시연 길이를 고려해 60초. -->
    <add key="PerclosWindowSec" value="60.0" />
    <add key="PerclosSuspectRatio" value="0.35" />

    <!-- ============================================================
         엎드림 휴리스틱
         ============================================================ -->
    <!-- 안면 인식은 객체 인식이 아니라서 '엎드려 잠' 과 '자리 비움' 을 원리적으로 구분할 수 없다.
         true 면 직전에 얼굴이 아래쪽/아래로 기운 상태였다가 사라진 경우를 AWAY 대신 DROWSY 로 유지한다.
         오검출 가능성이 있는 보정이다. 데모에서 헷갈리면 false 로 끄고 시연할 것. -->
    <add key="EnableSlumpHeuristic" value="true" />

    <!-- ============================================================
         프레임 유실 / tracking
         ============================================================ -->
    <!-- 직전 프레임과의 간격이 이 값을 넘으면(카메라 끊김, 창 최소화 등) 누적 카운터를 리셋한다. -->
    <add key="FrameGapResetSec" value="1.0" />

    <!-- Face.id(continuous tracking ID) 가 바뀌면 상태를 리셋할지.
         id 가 자주 튀어서 상태가 계속 초기화되면 false 로 내릴 것. -->
    <add key="ResetOnTrackIdChange" value="true" />

    <!-- ============================================================
         카메라 (캡처)
         ============================================================ -->
    <!-- 카메라 인덱스. 노트북 내장캠이 0, 외장 USB 캠이 1 인 경우가 많다.
         UI 의 카메라 목록에서 실제 인덱스를 확인할 수 있다. -->
    <add key="CameraIndex" value="0" />

    <!-- 카메라에 '요청' 할 해상도. 카메라가 거부하면 다른 값으로 열리며, 실제 적용값은 UI 에 표시된다. -->
    <add key="CaptureWidth" value="1280" />
    <add key="CaptureHeight" value="720" />

    <!-- FourCC. MJPG 는 대부분의 USB 캠에서 1280x720 30fps 를 내준다.
         YUY2 로 열리면 720p 가 5~10fps 로 떨어지는 카메라가 많다.
         값: MJPG / YUY2 / (빈 문자열이면 설정하지 않음) -->
    <add key="CaptureCodec" value="MJPG" />

    <!-- 좌우 반전(거울 모드). 화면을 보는 사람 기준이 자연스러우므로 기본 true.
         판정에는 영향이 없다(눈꺼풀 거리는 좌우 대칭). -->
    <add key="FlipHorizontal" value="true" />

    <!-- VideoCapture 백엔드. [AppSettings 에 없는 확장 키 — CameraCapture 가 직접 읽는다]
         값: ANY / MSMF / DSHOW / FFMPEG
         카메라가 열리는데 프레임이 안 들어오면 DSHOW 로 바꿔볼 것(MSMF 에서 실패하는 캠이 있다). -->
    <add key="CaptureApi" value="ANY" />

    <!-- ============================================================
         분석 입력 이미지 (성능/정확도의 핵심)
         ============================================================ -->
    <!-- SDK 에 넘길 이미지 크기. 기본은 720x1280 세로 (부록 A-7, 성능 목적).
         캡처 이미지는 [좌우반전] -> [회전] -> [종횡비 중앙 크롭] -> [리사이즈] 순서로 이 크기에 맞춰진다.
         FrameObservation 의 box/landmark 좌표와 화면 미리보기가 모두 이 크기 기준이다.
         키우면 작은 얼굴을 더 잘 잡지만 프레임당 SDK 시간이 늘어난다.

         주의: EyelidClosedThreshold 는 얼굴이 화면에서 차지하는 픽셀 크기에 비례한다.
               이 값을 바꾸면 눈 개폐 임계도 함께 재보정해야 한다. -->
    <add key="AnalyzeWidth" value="720" />
    <add key="AnalyzeHeight" value="1280" />

    <!-- 캡처 직후 적용할 회전각. 0 / 90 / 180 / 270 만 유효(그 외는 0 으로 되돌아간다).
         카메라를 물리적으로 세로로 설치했으면 0.
         가로 웹캠(1280x720)을 세로 화면처럼 쓰려면 90 또는 270. -->
    <add key="SrcRotateDegrees" value="0" />

    <!-- 회전 후 AnalyzeWidth:AnalyzeHeight 종횡비로 중앙 크롭할지.
         false 면 종횡비가 찌그러진 채 리사이즈되어 landmark 정확도가 떨어진다. 켜 두는 것을 권장. -->
    <add key="EnableAspectCrop" value="true" />

    <!-- 크롭 결과를 AnalyzeWidth x AnalyzeHeight 로 리사이즈할지.
         false 면 크롭한 원본 해상도를 그대로 SDK 에 넘긴다(느리지만 화질 손실 없음).
         이 경우 SDK 에 넘어가는 크기가 720x1280 이 아니게 되므로 임계값 재보정이 필요하다. -->
    <add key="EnableAnalyzeResize" value="true" />

    <!-- ============================================================
         성능
         ============================================================ -->
    <!-- CheckMask / DetectFineOcclusion 호출 주기(프레임). 1 이면 매 프레임.
         호출하지 않은 프레임은 직전 측정값을 재사용하고, 캐시가 없으면 NaN(미측정)이 된다.
         마스크 착용 여부는 초 단위로 안 바뀌므로 5 정도면 충분하다. -->
    <add key="AttrIntervalFrames" value="5" />

    <!-- 목표 분석 FPS. 0 이면 제한 없음(카메라 속도에 맡김).
         10 이면 프레임 간격 100ms. CPU 여유가 없으면 낮추고, 깜빡임을 세려면 25 이상으로 올린다. -->
    <add key="TargetAnalyzeFps" value="10.0" />

    <!-- 106점 landmark 를 FrameObservation 에 채울지. [AppSettings 에 없는 확장 키]
         오버레이 그리기 전용이다. 판정에는 쓰지 않는다.
         SDK wrapper 의 LandMark.ToArray() 가 프레임당 리플렉션 106회 + 박싱 106회를 한다.
         오버레이가 필요 없거나 FPS 가 부족하면 false 로 끌 것. -->
    <add key="EnableLandmark106" value="true" />

    <!-- ============================================================
         로깅
         ============================================================ -->
    <!-- 프레임 단위 CSV 를 남길지. 임계값 재보정용 원시 데이터라 PoC 기간에는 켜 두는 것을 권장. -->
    <add key="EnableFrameCsv" value="true" />

    <!-- 로그 폴더. 상대경로면 exe 폴더 기준. -->
    <add key="LogDirectory" value="logs" />

  </appSettings>
</configuration>
